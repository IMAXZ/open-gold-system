{
  "ConnectionStrings": {
    "GoldDb": "Server=localhost;Port=3306;Database=assets;User ID=root;Password=CHANGE_ME;MinimumPoolSize=0;MaximumPoolSize=4;ConnectionTimeout=5;DefaultCommandTimeout=5;"
  },
  "Gold": {
    "Enabled": true,
    "Api": {
      "BaseUrl": "https://api.gold-api.com/",
      "TimeoutMs": 5000
    },
    "ExchangeRate": {
      "Default": 7.25
    }
  },
  "Collector": {
    "Cron": "0 0/1 * * * ?"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:8080"]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Quartz": "Information"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gold-collector-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
